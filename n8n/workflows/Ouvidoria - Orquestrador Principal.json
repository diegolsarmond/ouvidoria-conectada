        "jsCode": "const data = $input.first().json;\nconst texto = data.responder_cidadao || data.output || data.resposta || 'Desculpe, não entendi. Pode reformular?';\n\nconst textoFormatado = texto\n  .replace(/\\*\\*/g, '*')\n  .replace(/\\s{2,}/g, ' ')\n  .replace(/\\s*\\n\\s*/g, '\\n')\n  .trim();\n\nconst blocos = textoFormatado\n  .split(/\\n{2,}/)\n  .map(b => b.trim())\n  .filter(b => b.length > 0);\n\nreturn blocos.map(b => ({ json: { texto: b } }));"
