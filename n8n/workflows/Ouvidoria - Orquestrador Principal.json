    {
      "parameters": {
        "jsCode": "const instanceName = $('Parametros').first().json.instanceName || 'Ouvidoria Municipal';\n\nreturn [{\n  json: {\n    responder_cidadao: `Olá! Sou o assistente virtual da Ouvidoria Municipal de ${instanceName}.\\n\\nPosso te ajudar com:\\n1 - *Registrar uma manifestação* (reclamação, denúncia, elogio, sugestão)\\n2 - *Consultar protocolo* existente\\n3 - *Falar com um atendente*\\n\\nComo posso te ajudar?`\n  }\n}];"
      },
      "id": "saudacao-001",
      "name": "Gerar Saudacao",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2400, -200]
    },
    {
      "parameters": {
        "jsCode": "// Formata resposta para envio via WhatsApp\nconst data = $input.first().json;\nconst texto = data.responder_cidadao || data.output || data.resposta || 'Desculpe, não entendi. Pode reformular?';\n\nconst textoFormatado = texto\n  .replace(/\\*\\*/g, '*')\n  .replace(/\\s{2,}/g, ' ')\n  .replace(/\\s*\\n\\s*/g, '\\n')\n  .trim();\n\n// Quebrar em blocos para mensagens longas\nconst blocos = textoFormatado\n  .split(/\\n{2,}/)\n  .map(b => b.trim())\n  .filter(b => b.length > 0);\n\nreturn blocos.map(b => ({ json: { texto: b } }));"
      },
      "id": "format-response-001",
      "name": "Formatar Resposta WhatsApp",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2880, -400]
    },
    {
      "parameters": {
        "dataTableId": {
          "__rl": true,
          "value": "<<DATATABLE_HISTORICO_ID>>",
          "mode": "list",
          "cachedResultName": "Ouvidoria_HistoricoCvs"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "remotejid": "={{ $('Parametros').item.json.remotejid }}",
            "sender": "assistant",
            "content": "={{ $input.all().map(i => i.json.texto).join(' ') }}"
          },
          "matchingColumns": [],
