    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.output;\nconst cleaned = String(raw || '').replace(/```json/gi, '').replace(/```/g, '').trim();\n\ntry {\n  const parsed = JSON.parse(cleaned);\n  return [{ json: { ...parsed, parse_error: false } }];\n} catch (e) {\n  // Fallback: tentar extrair intencao por regex\n  const intMatch = raw.match(/\"intencao\"\\s*:\\s*\"([^\"]+)\"/);\n  return [{\n    json: {\n      intencao: intMatch ? intMatch[1] : 'nova_manifestacao',\n      confianca: 0.5,\n      dados_detectados: {},\n      parse_error: true,\n      raw_output: raw\n    }\n  }];\n}"
      },
      "id": "parse-router-001",
      "name": "Parsear Roteamento",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1920, -400]
