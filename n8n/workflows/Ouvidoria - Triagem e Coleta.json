{
  "name": "Ouvidoria - Triagem e Coleta Inteligente",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger-tc-001",
      "name": "Inicio",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [-800, -200]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nreturn [{\n  json: {\n    remotejid: input.remotejid,\n    mensagem: input.mensagem,\n    historico: input.historico ? JSON.parse(input.historico) : [],\n    dados_roteador: input.dados_roteador ? JSON.parse(input.dados_roteador) : {},\n    resumo_historico: input.resumo_historico || ''\n  }\n}];"
      },
      "id": "parse-input-tc-001",
      "name": "Parsear Entrada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-560, -200]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "assistant_prompts",
        "returnAll": true
      },
      "id": "fetch-prompts-tc-001",
      "name": "Buscar Prompts",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [-320, -400],
      "credentials": {
        "supabaseApi": { "id": "<<SUPABASE_CREDENTIAL_ID>>", "name": "Supabase - Ouvidoria" }
      }
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "<<ID_WORKFLOW_PRECADASTRO>>",
          "mode": "list",
          "cachedResultName": "Ouvidoria - PréCadastro"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": { "remotejid": "={{ $json.remotejid }}" },
          "matchingColumns": ["remotejid"],
          "schema": [{ "id": "remotejid", "displayName": "remotejid", "type": "string" }]
        },
        "options": {}
      },
      "id": "precad-tc-001",
      "name": "Buscar Dados Existentes",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [-320, -200]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=CONTEXTO DO ROTEADOR:\n{{ $('Parsear Entrada').first().json.dados_roteador ? JSON.stringify($('Parsear Entrada').first().json.dados_roteador.dados_detectados || {}) : '{}' }}\n\nDADOS JÁ COLETADOS NA SESSÃO:\n{{ JSON.stringify($('Buscar Dados Existentes').first().json.output || {}) }}\n\nRESUMO DO HISTÓRICO:\n{{ $('Parsear Entrada').first().json.resumo_historico }}\n\nÚLTIMA MENSAGEM DO CIDADÃO:\n{{ $('Parsear Entrada').first().json.mensagem }}",
        "options": {
          "systemMessage": "=Você é o assistente virtual da Ouvidoria Municipal, atencioso, claro e objetivo.\nSeu papel é coletar informações de manifestações de cidadãos via WhatsApp.\nHoje é {{ $now.format('dd/MM/yyyy') + ' e agora são ' + $now.format('HH:mm') }}.\n\n{{ $('Buscar Prompts').first().json.cadastro }}\n\nIMPORTANTE - DADOS JÁ CONHECIDOS:\nO roteador já analisou a mensagem inicial e extraiu dados automaticamente.\nVocê DEVE usar esses dados e NÃO perguntar novamente o que já é conhecido.\nApenas preencha os dados_extraidos com o que já veio do roteador + o que o cidadão informou.\n\nSe o campo 'area' foi detectado pelo roteador, USE-O diretamente.\nSe o campo 'tipo_manifestacao' foi detectado, USE-O.\nSe dados de localização foram detectados, USE-OS."
        }
      },
      "id": "agent-coleta-001",
      "name": "Agente de Coleta Inteligente",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [0, -200]
    },
    {
      "parameters": { "options": {} },
      "id": "llm-coleta-001",
      "name": "LLM Coleta",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [0, 0],
      "credentials": {
        "googlePalmApi": { "id": "<<GOOGLE_CREDENTIAL_ID>>", "name": "Google AI" }
      }
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('Parsear Entrada').first().json.remotejid.split('@')[0] }}",
        "sessionTTL": 3600,
        "contextWindowLength": 15
      },
      "id": "memory-coleta-001",
      "name": "Memoria Coleta",
      "type": "@n8n/n8n-nodes-langchain.memoryRedisChat",
      "typeVersion": 1.5,
      "position": [128, 0],
      "credentials": {
        "redis": { "id": "<<REDIS_CREDENTIAL_ID>>", "name": "Redis" }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $('Parsear Entrada').first().json.resumo_historico }}\nÚltima mensagem: {{ $('Parsear Entrada').first().json.mensagem }}",
        "options": {
          "systemMessage": "={{ $('Buscar Prompts').first().json.base_conhecimento || 'Busque informações relevantes sobre a demanda do cidadão na base de conhecimento.' }}"
        }
      },
      "id": "agent-rag-001",
      "name": "Agente RAG (Base de Conhecimento)",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [0, -500]
    },
    {
      "parameters": { "options": {} },
      "id": "llm-rag-001",
      "name": "LLM RAG",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [0, -300],
      "credentials": {
        "googlePalmApi": { "id": "<<GOOGLE_CREDENTIAL_ID>>", "name": "Google AI" }
      }
    },
    {
      "parameters": {
        "mode": "retrieve-as-tool",
        "toolDescription": "Busque informações relevantes sobre serviços públicos, órgãos, procedimentos e orientações relacionadas à demanda do cidadão",
        "tableName": {
          "__rl": true,
          "value": "documents",
          "mode": "list",
          "cachedResultName": "documents"
        },
        "options": {}
      },
      "id": "vectorstore-001",
      "name": "Base de Conhecimento (Vector Store)",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreSupabase",
      "typeVersion": 1.3,
      "position": [128, -300],
      "credentials": {
        "supabaseApi": { "id": "<<SUPABASE_CREDENTIAL_ID>>", "name": "Supabase - Ouvidoria" }
      }
    },
    {
      "parameters": {
        "modelName": "models/gemini-embedding-001"
      },
      "id": "embeddings-001",
      "name": "Embeddings",
      "type": "@n8n/n8n-nodes-langchain.embeddingsGoogleGemini",
      "typeVersion": 1,
      "position": [256, -300],
      "credentials": {
        "googlePalmApi": { "id": "<<GOOGLE_CREDENTIAL_ID>>", "name": "Google AI" }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.output;\nconst cleaned = String(raw || '')\n  .replace(/```json/gi, '')\n  .replace(/```/g, '')\n  .trim();\n\ntry {\n  const parsed = JSON.parse(cleaned);\n  const dados = parsed?.dados_extraidos ?? {};\n  const camposConfigurados = parsed?.acao_sistema?.campos_para_salvar;\n\n  const campos = Array.isArray(camposConfigurados) && camposConfigurados.length > 0\n    ? camposConfigurados\n    : Object.keys(dados).filter(campo => \n        dados[campo] !== null && \n        dados[campo] !== undefined && \n        dados[campo] !== '' &&\n        campo !== 'canal_origem' &&\n        campo !== 'confirmado_usuario'\n      );\n\n  return [{\n    json: {\n      ...parsed,\n      campos_para_update: campos.map(campo => ({\n        campo,\n        valor: dados[campo] ?? null\n      })),\n      parse_error: false\n    }\n  }];\n} catch (e) {\n  // Fallback: extrair responder_cidadao por regex\n  const respMatch = raw.match(/\"responder_cidadao\"\\s*:\\s*\"([^\"]+)\"/);\n  return [{\n    json: {\n      responder_cidadao: respMatch ? respMatch[1] : raw,\n      status_coleta: { completo: false },\n      dados_extraidos: {},\n      acao_sistema: { armazenar: false, campos_para_salvar: [] },\n      campos_para_update: [],\n      parse_error: true\n    }\n  }];\n}"
      },
      "id": "parse-coleta-001",
      "name": "Parsear Resposta Coleta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, -200]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3 },
          "conditions": [
            {
              "id": "if-salvar",
              "leftValue": "={{ $json.acao_sistema.armazenar }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-salvar-001",
      "name": "Precisa Salvar?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [480, -200]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "loop-update-001",
      "name": "Loop Campos",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [720, -400]
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "conversas_ativas",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            { "keyName": "remotejid", "condition": "eq", "keyValue": "={{ $('Parsear Entrada').first().json.remotejid }}" },
            { "keyName": "id", "condition": "eq", "keyValue": "={{ $('Buscar Dados Existentes').first().json.output.id }}" }
          ]
        },
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "={{ $json.campo }}",
              "fieldValue": "={{ typeof $json.valor === 'boolean' ? $json.valor : $json.valor?.normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase() }}"
            }
          ]
        }
      },
      "id": "update-supabase-001",
      "name": "Atualizar Supabase",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [960, -300],
      "credentials": {
        "supabaseApi": { "id": "<<SUPABASE_CREDENTIAL_ID>>", "name": "Supabase - Ouvidoria" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3 },
          "conditions": [
            {
              "id": "if-completo",
              "leftValue": "={{ $('Parsear Resposta Coleta').first().json.status_coleta.completo }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-completo-001",
      "name": "Coleta Completa?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [720, -200]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3 },
                "conditions": [
                  {
                    "id": "sw-confirm",
                    "leftValue": "={{ $('Parsear Resposta Coleta').first().json.status_coleta.fase }}",
                    "rightValue": "CONFIRMADO",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "CONFIRMADO"
            }
          ]
        },
        "options": { "fallbackOutput": "extra", "renameFallbackOutput": "AGUARDANDO_CONFIRMACAO" }
      },
      "id": "sw-fase-001",
      "name": "Fase da Coleta",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [960, -200]
    },
    {
      "parameters": {
        "jsCode": "const dados = $('Buscar Dados Existentes').first().json.output;\nconst protocolo = dados.protocolo || 'N/A';\n\nreturn [\n  { json: { responder_cidadao: `Sua manifestação foi registrada com sucesso na Ouvidoria sob o protocolo *${protocolo}*.` } },\n  { json: { responder_cidadao: 'Sua demanda foi encaminhada para análise e em breve você receberá atualizações por aqui.' } },\n  { json: { responder_cidadao: 'Posso te ajudar com mais alguma coisa?' } }\n];"
      },
      "id": "msg-sucesso-001",
      "name": "Mensagem de Sucesso",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, -400]
    },
    {
      "parameters": {
        "jsCode": "const parsed = $('Parsear Resposta Coleta').first().json;\nreturn [{ json: { responder_cidadao: parsed.responder_cidadao } }];"
      },
      "id": "msg-proxima-001",
      "name": "Proxima Pergunta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, -100]
    },
    {
      "parameters": {
        "jsCode": "// Merge das saídas - retorna responder_cidadao para o workflow pai\nconst items = $input.all();\nconst resposta = items.map(i => i.json.responder_cidadao).filter(Boolean).join('\\n\\n');\nreturn [{ json: { responder_cidadao: resposta } }];"
      },
      "id": "merge-output-001",
      "name": "Preparar Saida",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1440, -200]
    }
  ],
  "connections": {
    "Inicio": { "main": [[{ "node": "Parsear Entrada", "type": "main", "index": 0 }]] },
    "Parsear Entrada": { "main": [[{ "node": "Buscar Prompts", "type": "main", "index": 0 }, { "node": "Buscar Dados Existentes", "type": "main", "index": 0 }, { "node": "Agente RAG (Base de Conhecimento)", "type": "main", "index": 0 }]] },
    "Buscar Prompts": { "main": [[{ "node": "Agente de Coleta Inteligente", "type": "main", "index": 0 }]] },
    "Buscar Dados Existentes": { "main": [[{ "node": "Agente de Coleta Inteligente", "type": "main", "index": 0 }]] },
    "Agente RAG (Base de Conhecimento)": { "main": [[{ "node": "Agente de Coleta Inteligente", "type": "main", "index": 0 }]] },
    "LLM RAG": { "ai_languageModel": [[{ "node": "Agente RAG (Base de Conhecimento)", "type": "ai_languageModel", "index": 0 }]] },
    "Base de Conhecimento (Vector Store)": { "ai_tool": [[{ "node": "Agente RAG (Base de Conhecimento)", "type": "ai_tool", "index": 0 }]] },
    "Embeddings": { "ai_embedding": [[{ "node": "Base de Conhecimento (Vector Store)", "type": "ai_embedding", "index": 0 }]] },
    "LLM Coleta": { "ai_languageModel": [[{ "node": "Agente de Coleta Inteligente", "type": "ai_languageModel", "index": 0 }]] },
    "Memoria Coleta": { "ai_memory": [[{ "node": "Agente de Coleta Inteligente", "type": "ai_memory", "index": 0 }]] },
    "Agente de Coleta Inteligente": { "main": [[{ "node": "Parsear Resposta Coleta", "type": "main", "index": 0 }]] },
    "Parsear Resposta Coleta": { "main": [[{ "node": "Precisa Salvar?", "type": "main", "index": 0 }, { "node": "Coleta Completa?", "type": "main", "index": 0 }]] },
    "Precisa Salvar?": { "main": [[{ "node": "Loop Campos", "type": "main", "index": 0 }], []] },
    "Loop Campos": { "main": [[], [{ "node": "Atualizar Supabase", "type": "main", "index": 0 }]] },
    "Atualizar Supabase": { "main": [[{ "node": "Loop Campos", "type": "main", "index": 0 }]] },
    "Coleta Completa?": { "main": [[{ "node": "Fase da Coleta", "type": "main", "index": 0 }], [{ "node": "Proxima Pergunta", "type": "main", "index": 0 }]] },
    "Fase da Coleta": { "main": [[{ "node": "Mensagem de Sucesso", "type": "main", "index": 0 }], [{ "node": "Proxima Pergunta", "type": "main", "index": 0 }]] },
    "Mensagem de Sucesso": { "main": [[{ "node": "Preparar Saida", "type": "main", "index": 0 }]] },
    "Proxima Pergunta": { "main": [[{ "node": "Preparar Saida", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "ouvidoria" }, { "name": "v2" }, { "name": "sub-workflow" }]
}
