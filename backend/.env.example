# Backend environment variables
PORT=3001
JWT_SECRET=your-production-jwt-secret

# Database
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=ouvidoria
DB_USER=ouvidoria
DB_PASSWORD=ouvidoria
DB_SSL=false

# Optional full database URL override
DATABASE_URL=postgres://ouvidoria:ouvidoria@127.0.0.1:5433/ouvidoria

# CORS origins for frontend apps
# Example: http://localhost:8080,http://localhost:5173,http://yourdomain.com
CORS_ORIGIN=http://localhost:8080,http://localhost:5173,http://192.168.30.9:4173,http://192.168.30.9:8080
