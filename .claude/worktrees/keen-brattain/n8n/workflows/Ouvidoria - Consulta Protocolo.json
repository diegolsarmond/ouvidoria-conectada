{
  "name": "Ouvidoria - Consulta Protocolo",
  "nodes": [
    {
      "parameters": { "inputSource": "passthrough" },
      "id": "trigger-cp-001",
      "name": "Inicio",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [-800, 400]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst dados = input.dados_roteador ? JSON.parse(input.dados_roteador) : {};\nconst detectados = dados.dados_detectados || {};\n\nreturn [{\n  json: {\n    remotejid: input.remotejid,\n    mensagem: input.mensagem,\n    protocolo_detectado: detectados.protocolo || null,\n    cpf_detectado: detectados.cpf || null\n  }\n}];"
      },
      "id": "parse-cp-001",
      "name": "Parsear Entrada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-560, 400]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "assistant_prompts",
        "returnAll": true
      },
      "id": "prompts-cp-001",
      "name": "Buscar Prompts",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [-320, 200],
      "credentials": {
        "supabaseApi": { "id": "vp31qZQSpdQd2U2t", "name": "Supabase - Ouvidoria" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3 },
          "conditions": [
            { "id": "if-proto", "leftValue": "={{ $('Parsear Entrada').first().json.protocolo_detectado }}", "rightValue": "", "operator": { "type": "string", "operation": "isNotEmpty" } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-proto-001",
      "name": "Tem Protocolo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [-320, 400]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "conversas_ativas",
        "returnAll": false,
        "limit": 1,
        "filters": {
          "conditions": [
            { "keyName": "protocolo", "condition": "eq", "keyValue": "={{ $('Parsear Entrada').first().json.protocolo_detectado }}" }
          ]
        }
      },
      "id": "buscar-proto-001",
      "name": "Buscar por Protocolo",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [-80, 200],
      "credentials": {
        "supabaseApi": { "id": "vp31qZQSpdQd2U2t", "name": "Supabase - Ouvidoria" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3 },
          "conditions": [
            { "id": "if-cpf", "leftValue": "={{ $('Parsear Entrada').first().json.cpf_detectado }}", "rightValue": "", "operator": { "type": "string", "operation": "isNotEmpty" } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-cpf-001",
      "name": "Tem CPF?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [-80, 500]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "conversas_ativas",
        "returnAll": true,
        "filters": {
          "conditions": [
            { "keyName": "cpf", "condition": "eq", "keyValue": "={{ $('Parsear Entrada').first().json.cpf_detectado }}" }
          ]
        }
      },
      "id": "buscar-cpf-001",
      "name": "Buscar por CPF",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [160, 500],
      "credentials": {
        "supabaseApi": { "id": "vp31qZQSpdQd2U2t", "name": "Supabase - Ouvidoria" }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=O cidadão disse: {{ $('Parsear Entrada').first().json.mensagem }}\n\nNenhum protocolo ou CPF foi detectado automaticamente.\nSiga o fluxo definido no seu prompt para pedir essas informações.",
        "options": {
          "systemMessage": "={{ $('Buscar Prompts').first().json.consulta }}"
        }
      },
      "id": "agent-consulta-sem-dados",
      "name": "Agente Consulta (Pedir Dados)",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [160, 700]
    },
    {
      "parameters": { "options": {} },
      "id": "llm-consulta-sem-dados",
      "name": "LLM Consulta Pedir",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [160, 900],
      "credentials": {
        "googlePalmApi": { "id": "sOjFjRkcPMCDP1wy", "name": "DIEGO" }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=O cidadão consultou e o sistema retornou os seguintes dados da manifestação:\n{{ JSON.stringify($input.first().json) }}\n\nFormate a resposta conforme o prompt de consulta.",
        "options": {
          "systemMessage": "={{ $('Buscar Prompts').first().json.consulta }}"
        }
      },
      "id": "agent-consulta-resultado",
      "name": "Agente Consulta (Formatar Resultado)",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [400, 300]
    },
    {
      "parameters": { "options": {} },
      "id": "llm-consulta-resultado",
      "name": "LLM Consulta Resultado",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [400, 500],
      "credentials": {
        "googlePalmApi": { "id": "sOjFjRkcPMCDP1wy", "name": "DIEGO" }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.output || $input.first().json.responder_cidadao || '';\nconst cleaned = raw.replace(/```json/gi, '').replace(/```/g, '').trim();\n\ntry {\n  const parsed = JSON.parse(cleaned);\n  return [{ json: { responder_cidadao: parsed.responder_cidadao || cleaned } }];\n} catch (e) {\n  return [{ json: { responder_cidadao: cleaned || 'Para consultar sua manifestação, informe o número do protocolo ou seu CPF.' } }];\n}"
      },
      "id": "preparar-saida-cp",
      "name": "Preparar Saida",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [640, 400]
    }
  ],
  "connections": {
    "Inicio": { "main": [[{ "node": "Parsear Entrada", "type": "main", "index": 0 }]] },
    "Parsear Entrada": { "main": [[
      { "node": "Buscar Prompts", "type": "main", "index": 0 },
      { "node": "Tem Protocolo?", "type": "main", "index": 0 }
    ]] },
    "Tem Protocolo?": { "main": [
      [{ "node": "Buscar por Protocolo", "type": "main", "index": 0 }],
      [{ "node": "Tem CPF?", "type": "main", "index": 0 }]
    ] },
    "Buscar por Protocolo": { "main": [[{ "node": "Agente Consulta (Formatar Resultado)", "type": "main", "index": 0 }]] },
    "Tem CPF?": { "main": [
      [{ "node": "Buscar por CPF", "type": "main", "index": 0 }],
      [{ "node": "Agente Consulta (Pedir Dados)", "type": "main", "index": 0 }]
    ] },
    "Buscar por CPF": { "main": [[{ "node": "Agente Consulta (Formatar Resultado)", "type": "main", "index": 0 }]] },

    "LLM Consulta Pedir": { "ai_languageModel": [[{ "node": "Agente Consulta (Pedir Dados)", "type": "ai_languageModel", "index": 0 }]] },
    "Agente Consulta (Pedir Dados)": { "main": [[{ "node": "Preparar Saida", "type": "main", "index": 0 }]] },

    "LLM Consulta Resultado": { "ai_languageModel": [[{ "node": "Agente Consulta (Formatar Resultado)", "type": "ai_languageModel", "index": 0 }]] },
    "Buscar Prompts": { "main": [[
      { "node": "Agente Consulta (Formatar Resultado)", "type": "main", "index": 0 },
      { "node": "Agente Consulta (Pedir Dados)", "type": "main", "index": 0 }
    ]] },
    "Agente Consulta (Formatar Resultado)": { "main": [[{ "node": "Preparar Saida", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "ouvidoria" }, { "name": "v2" }, { "name": "sub-workflow" }],
  "meta": { "templateCredsSetupCompleted": true }
}
