              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3 },
                "conditions": [
                  { "id": "sw-confirm", "leftValue": "={{ $('Parsear Resposta Coleta').first().json.status_coleta.fase }}", "rightValue": "CONFIRMADO", "operator": { "type": "string", "operation": "equals" } }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "CONFIRMADO"
            }
          ]
        },
        "options": { "fallbackOutput": "extra", "renameFallbackOutput": "AGUARDANDO_CONFIRMACAO" }
      },
