    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('Parsear Entrada').first().json.remotejid.split('@')[0] }}",
        "sessionTTL": 3600,
        "contextWindowLength": 15
      },
      "id": "7269846b-2e83-4f5a-b486-93b739ce3f3d",
      "name": "Memoria Coleta",
      "type": "@n8n/n8n-nodes-langchain.memoryRedisChat",
      "typeVersion": 1.5,
      "position": [368, 624],
      "credentials": {
        "redis": { "id": "2cEQC4iAOPiyvfWA", "name": "Redis" }
      }
    },

    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.output;\nconst cleaned = String(raw || '')\n  .replace(/```json/gi, '')\n  .replace(/```/g, '')\n  .trim();\n\ntry {\n  const parsed = JSON.parse(cleaned);\n  const dados = parsed?.dados_extraidos ?? {};\n  const camposConfigurados = parsed?.acao_sistema?.campos_para_salvar;\n\n  const campos = Array.isArray(camposConfigurados) && camposConfigurados.length > 0\n    ? camposConfigurados\n    : Object.keys(dados).filter(campo => \n        dados[campo] !== null && \n        dados[campo] !== undefined && \n        dados[campo] !== '' &&\n        campo !== 'canal_origem' &&\n        campo !== 'confirmado_usuario'\n      );\n\n  return [{\n    json: {\n      ...parsed,\n      campos_para_update: campos.map(campo => ({\n        campo,\n        valor: dados[campo] ?? null\n      })),\n      parse_error: false\n    }\n  }];\n} catch (e) {\n  const respMatch = raw.match(/\"responder_cidadao\"\\s*:\\s*\"([^\"]+)\"/);\n  return [{\n    json: {\n      responder_cidadao: respMatch ? respMatch[1] : raw,\n      status_coleta: { completo: false },\n      dados_extraidos: {},\n      acao_sistema: { armazenar: false, campos_para_salvar: [] },\n      campos_para_update: [],\n      parse_error: true\n    }\n  }];\n}"
      },
      "id": "93e41cac-c27a-4b37-a24f-980591469e5c",
      "name": "Parsear Resposta Coleta",
