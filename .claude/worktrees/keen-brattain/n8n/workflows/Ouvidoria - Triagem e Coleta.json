    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.output;\nconst cleaned = String(raw || '').replace(/```json/gi, '').replace(/```/g, '').trim();\n\ntry {\n  const parsed = JSON.parse(cleaned);\n  return [{ json: { ...parsed, parse_error: false } }];\n} catch (e) {\n  return [{\n    json: {\n      analise: { resumo: raw, complexidade: 'media', sentimento: 'neutro', precisa_base_conhecimento: false },\n      dados_extraidos: {},\n      campos_faltantes: [],\n      proxima_pergunta_sugerida: null,\n      parse_error: true,\n      raw_output: raw\n    }\n  }];\n}"
      },
      "id": "triagem-parse-001",
      "name": "Parsear Triagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [0, 400]
    },

    {
      "parameters": {
        "promptType": "define",
        "text": "=RESULTADO DA TRIAGEM:\n{{ JSON.stringify($('Parsear Triagem').first().json) }}\n\nDADOS JÁ COLETADOS NA SESSÃO:\n{{ JSON.stringify($('Buscar Dados Existentes').first().json.output || {}) }}\n\nRESUMO DO HISTÓRICO:\n{{ $('Parsear Entrada').first().json.resumo_historico }}\n\nÚLTIMA MENSAGEM DO CIDADÃO:\n{{ $('Parsear Entrada').first().json.mensagem }}",
        "options": {
          "systemMessage": "=Você é o assistente virtual da Ouvidoria Municipal, atencioso, claro e objetivo.\nSeu papel é coletar informações de manifestações de cidadãos via WhatsApp.\nHoje é {{ $now.format('dd/MM/yyyy') + ' e agora são ' + $now.format('HH:mm') }}.\n\n{{ $('Buscar Prompts').first().json.cadastro }}\n\nIMPORTANTE - DADOS JÁ CONHECIDOS:\nA triagem já analisou a mensagem e extraiu dados automaticamente.\nVocê DEVE usar esses dados e NÃO perguntar novamente o que já é conhecido.\nApenas preencha os dados_extraidos com o que já veio da triagem + o que o cidadão informou.\n\nSe o campo 'area' foi detectado, USE-O diretamente.\nSe o campo 'tipo_manifestacao' foi detectado, USE-O.\nSe dados de localização foram detectados, USE-OS."
        }
      },
      "id": "6a3fd83d-f2b9-4753-827b-1177cdda8724",
      "name": "Agente de Coleta Inteligente",
