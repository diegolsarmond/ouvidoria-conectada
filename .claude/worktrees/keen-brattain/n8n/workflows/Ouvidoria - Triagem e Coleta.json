    {
      "parameters": {
        "promptType": "define",
        "text": "=Mensagem do cidadão: {{ $('Parsear Entrada').first().json.mensagem }}\n\nDados já detectados pelo roteador:\n{{ JSON.stringify($('Parsear Entrada').first().json.dados_roteador.dados_detectados || {}) }}\n\nInformações da base de conhecimento:\n{{ $('Agente RAG (Base de Conhecimento)').first().json.output || 'Nenhuma informação encontrada na base.' }}\n\nDados já coletados na sessão:\n{{ JSON.stringify($('Buscar Dados Existentes').first().json.output || {}) }}\n\nHoje é {{ $now.format('dd/MM/yyyy') }}.",
