      "name": "LLM Coleta",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [240, 624],
      "credentials": {
        "googlePalmApi": { "id": "sOjFjRkcPMCDP1wy", "name": "DIEGO" }
