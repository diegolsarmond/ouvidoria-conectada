      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst resposta = data.responder_cidadao || data.output?.responder_cidadao || data.output || '';\n\nconst textoFormatado = String(resposta)\n  .replace(/\\*\\*/g, '')\n  .replace(/\\*/g, '')\n  .replace(/\\s{2,}/g, ' ')\n  .replace(/\\s*\\n\\s*/g, '\\n')\n  .replace(/\\b(1|2|3|4|Dr|Dra|Sr|Sra|Srta|Prof|Profa|Exmo|Exma|etc|Ex|Fig|Vol|Pág|N)\\./gi, '$1{{PONTO}}')\n  .replace(/\\.(\\s|$)/g, '.\\n\\n')\n  .replace(/([!?])(\\s|$)/g, '$1\\n\\n')\n  .replace(/{{PONTO}}/g, '.')\n  .replace(/\\r\\n/g, '\\n')\n  .trim();\n\nconst blocos = textoFormatado\n  .split(/\\n+/)\n  .map(b => b.trim())\n  .filter(b => b.length > 0);\n\nreturn blocos.map(b => ({ json: { texto: b } }));"
      },
